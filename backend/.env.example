# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# AWS CREDENTIALS (REQUERIDO)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# DYNAMODB TABLES
# ============================================
TABLE_USERS=Usuarios
TABLE_VEHICLES=Vehiculos
TABLE_GPS=GPS
TABLE_COORDINATES=Coordenadas
TABLE_CERTIFICATES=Certificados
TABLE_COMMANDS=Comandos

# ============================================
# AWS IOT CORE (REQUERIDO)
# ============================================
IOT_ENDPOINT=xxxxx-ats.iot.us-east-1.amazonaws.com
IOT_THING_GROUP=FleetGPSDevices
IOT_POLICY_NAME=VehicleGPSPolicy

# ============================================
# AWS S3 (REQUERIDO)
# ============================================
S3_CERTIFICATES_BUCKET=fleet-certificates

# ============================================
# AWS LOCATION SERVICE
# ============================================
LOCATION_TRACKER_NAME=VehicleTracker
LOCATION_MAP_NAME=StandardLight

# ============================================
# JWT (AUTHENTICATION)
# ============================================
JWT_SECRET=change-this-super-secret-key-in-production-minimum-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-too-minimum-32-characters
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIRECTORY=logs